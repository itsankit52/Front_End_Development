<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Users</title>
    <link rel="stylesheet" href="/style/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>

    <div class="w-full min-h-screen bg-zinc-900 text-white p-8">

        <a href="/" class="inline-block px-4 py-2 mb-6 bg-blue-600 rounded-lg hover:bg-blue-700 transition">
            Back to Home
        </a>

        <h1 class="text-4xl font-serif font-bold mb-8">
            All Users
        </h1>
        <% if(users.length> 0){%>
            <div class="flex flex-wrap gap-6">

                <% users.forEach(function(user){ %>

                    <div class="w-72 p-5 bg-zinc-800 rounded-2xl shadow-xl hover:scale-105 transition-all duration-300">

                        <div class="w-full h-56 bg-blue-500 rounded-xl overflow-hidden">

                            <% if(user.image){ %>

                                <img src="<%= user.image %>" alt="User Image" class="w-full h-full object-cover">

                                <% } else { %>

                                    <div class="w-full h-full flex items-center justify-center text-white">
                                        No Image
                                    </div>

                                    <% } %>

                        </div>

                        <h1 class="text-2xl font-semibold mt-4">
                            <%= user.name %>
                        </h1>

                        <h3 class="text-zinc-400 mt-1 break-all">
                            <%= user.email %>
                        </h3>

                        <div class="w-full pt-5 flex justify-between items-center">

                            <a href="/edit/<%= user._id %>"
                                class="px-4 py-2 bg-blue-600 rounded-lg hover:bg-blue-700 transition">
                                Edit
                            </a>

                            <a href="/delete/<%= user._id %>"
                                class="px-4 py-2 bg-red-600 rounded-lg hover:bg-red-700 transition">
                                Delete User
                            </a>

                        </div>

                    </div>

                    <% }) %>

            </div>

            <% } else {%>
                <h3 class="text-2xl font-serif ">No Users Yet ...</h3>
                <% }%>

    </div>

</body>

</html>