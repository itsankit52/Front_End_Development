<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit User</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>

    <div class="w-full min-h-screen bg-zinc-900 text-white p-8">

        <h1 class="text-4xl font-bold mb-8">
            Edit User Details
        </h1>

        <form action="/update/<%= user._id %>" method="post"
              class="flex flex-col gap-4 w-96">

            <input
                class="px-5 py-3 bg-zinc-800 border border-zinc-600 rounded-lg outline-none"
                type="text"
                name="name"
                value="<%= user.name %>">

            <input
                class="px-5 py-3 bg-zinc-800 border border-zinc-600 rounded-lg outline-none"
                type="text"
                name="email"
                value="<%= user.email %>">

            <input
                class="px-5 py-3 bg-zinc-800 border border-zinc-600 rounded-lg outline-none"
                type="text"
                name="image"
                value="<%= user.image %>">

           <input
    class="px-6 py-3 text-xl font-semibold text-black bg-yellow-500 rounded-lg cursor-pointer hover:bg-yellow-600 transition-all duration-300"
    type="submit"
    value="Update">
        </form>

    </div>

</body>

</html>