<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style/style.css">
    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body>
    <div class="w-full h-full bg-zinc-700 text-white">

        <div class="nav w-40 p-2 m-2 text-md cursor-pointer bg-blue-600 rounded-lg hover:bg-blue-800 transition">
            <a href="/read">See All Users</a>
        </div>

        <h1 class="px-2 py-2 m-2 bg-blue-500 rounded-lg text-3xl">Create Users </h1>
        <form action="/create" method="post">

            <input
                class="m-2 px-5 py-3 bg-zinc-800 text-white placeholder:text-zinc-400 border-2 border-zinc-600 outline-none rounded-lg"
                type="text" name="name" placeholder="Enter Name">

            <input
                class="m-2 px-5 py-3 bg-zinc-800 text-white placeholder:text-zinc-400 border-2 border-zinc-600 outline-none rounded-lg"
                type="text" name="email" placeholder="Enter Email">

            <input
                class="m-2 px-5 py-3 bg-zinc-800 text-white placeholder:text-zinc-400 border-2 border-zinc-600 outline-none rounded-lg"
                type="text" name="image" placeholder="Image">

            <input class="px-5 py-3 m-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 cursor-pointer" type="submit"
                value="Create User">

        </form>
    </div>
</body>
</html>