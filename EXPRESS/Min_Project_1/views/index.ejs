<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-zinc-900 flex justify-center items-center min-h-screen">

    <div class="w-full max-w-md bg-zinc-800 rounded-2xl shadow-lg p-6">

        <h1 class="text-3xl font-bold text-white text-center mb-6">
            Create Account for Your Post
        </h1>

        <form action="/register" method="post" class="flex flex-col gap-4">

            <input type="text" name="name" placeholder="Enter Your Name" required
                class="w-full px-4 py-3 rounded-lg outline-none border border-zinc-600 focus:border-blue-500">

            <input type="text" name="username" placeholder="Enter Your Username" required
                class="w-full px-4 py-3 rounded-lg outline-none border border-zinc-600 focus:border-blue-500">

            <input type="email" name="email" placeholder="Enter Your Email" required
                class="w-full px-4 py-3 rounded-lg outline-none border border-zinc-600 focus:border-blue-500">

            <input type="password" name="password" placeholder="Enter Your Password" required
                class="w-full px-4 py-3 rounded-lg outline-none border border-zinc-600 focus:border-blue-500">

            <input type="number" name="age" placeholder="Enter Your Age" required min="1" max="120"
                class="w-full px-4 py-3 rounded-lg outline-none border border-zinc-600 focus:border-blue-500">

            <div class="flex gap-4 mt-4">

                <button type="submit"
                    class="w-1/2 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-lg transition duration-300">
                    Create Account
                </button>

                <a href="/login"
                    class="w-1/2 flex justify-center items-center bg-green-600 hover:bg-green-700 text-white font-semibold py-3 rounded-lg transition duration-300">
                    Login
                </a>

            </div>

        </form>

    </div>

</body>

</html>