<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-zinc-900 min-h-screen text-white">
    <div class="fixed top-5 right-5">

        <a href="/logout"
            class="bg-red-600 hover:bg-red-700 text-white font-semibold px-5 py-2 rounded-lg transition duration-300 shadow-lg">
            Logout
        </a>

    </div>
    <div class="w-full h-screen p-10">

        <h1 class="text-4xl font-bold mb-8">
            Hello, <%= user.username %>✌️
        </h1>
        <div class="flex gap-10 mb-8">
            <div>
                <p class="text-zinc-400 mb-2">
                    User ID
                </p>

                <p class="text-xl text-white font-semibold break-all">
                    <%= user._id %>
                </p>
            </div>
        </div>


        <form action="/post/create" method="post">

            <p class="mb-3 text-lg">
                Create Your Post
            </p>

            <input type="text" name="title" placeholder="Enter Post Title"
                class="w-full mb-4 outline-none px-4 py-3 bg-zinc-800 border border-blue-700 rounded-lg" required>

            <textarea name="description" rows="6"
                class="w-full resize-none outline-none px-4 py-3 bg-zinc-800 border border-blue-700 rounded-lg"
                placeholder="Write Description" required>
            </textarea>

            <button class="mt-5 bg-blue-600 hover:bg-blue-700 px-8 py-3 rounded-lg" type="submit">
                Create Post
            </button>
        </form>

        <div class="posts mt-10">
            <p class="text-2xl font-bold text-white mb-5">
                Your Posts
            </p>
            <% user.posts.forEach(function(post){ %>
                <div class="mb-5 p-5 rounded-2xl bg-zinc-800 border border-blue-700">
                    <h2 class="text-2xl font-bold text-white">
                        <%= post.title %>
                    </h2>

                    <p class="text-zinc-300 mt-3">
                        <%= post.description %>
                    </p>

                    <a href="/post/delete/<%= post._id %>"
                        class="inline-block mt-4 bg-red-600 hover:bg-red-700 px-4 py-2 rounded-lg text-white">
                        Delete
                    </a>
                </div>
                <% }) %>
        </div>
    </div>
</body>

</html>